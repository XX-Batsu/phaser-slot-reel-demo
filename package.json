{
  "name": "phaser-slot-reel-demo",
  "version": "1.0.0",
  "description": "Phaser-based slot-reel game client demo (offline, no backend required).",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "nohoist": [
      "**/slot-base",
      "**/GameExternal",
      "**/bs-html-injector"
    ]
  },
  "scripts": {
    "dll": "yarn workspace laima run dll:no-base",
    "start": "yarn workspace laima run start",
    "build:standalone": "yarn workspace laima run build:standalone",
    "serve": "http-server apps/islandofadventure/build -p 8080 -c-1",
    "lint": "yarn workspace laima run lint",
    "test": "yarn workspace laima run test"
  },
  "devDependencies": {
    "http-server": "0.12.3"
  },
  "engines": {
    "node": ">=10"
  }
}
