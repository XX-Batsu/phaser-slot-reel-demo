doctype html
//- html(lang="en" data-rev=htmlWebpackPlugin.options.rev data-tag=htmlWebpackPlugin.options.tag, data-baseVer=htmlWebpackPlugin.options.baseVer, data-commonVer=htmlWebpackPlugin.options.commonVer)
html()
head
  head
    meta(charset="utf-8")
    title IslandOfAdventure
    //- link(rel="shortcut icon" href=htmlWebpackPlugin.options.commonFilePath + "/images/favicon.ico?yolo")
